{
    "name": "wildweather",
    "description": "WildWeather TypeScript React website.",
    "private": true,
    "version": "1.6.0",
    "type": "module",
    "author": "Henry de Lange (MyWild)",
    "license": "MIT",
    "scripts": {
        "dev": "npm run git:info && vite",
        "rtk-query:codegen": "npx @rtk-query/codegen-openapi@latest ./openapi-config.json",
        "pwa-assets:generate": "pwa-assets-generator",
        "build": "npm run git:info && tsc -b && vite build",
        "git:info": "node generate-git-info.cjs",
        "license:summary": "npx license-checker@latest --summary --out licenses-summary.txt",
        "license:csv": "npx license-checker@latest --csv --out licenses.csv",
        "lint": "eslint .",
        "preview": "vite preview"
    },
    "dependencies": {
        "@base-ui/react": "^1.5.0",
        "@reduxjs/toolkit": "^2.12.0",
        "@tanstack/react-router": "^1.167.0",
        "@tanstack/react-router-devtools": "^1.167.0",
        "async-mutex": "^0.5.0",
        "echarts": "^6.1.0",
        "echarts-for-react": "^3.0.6",
        "i18next": "^26.3.1",
        "i18next-browser-languagedetector": "^8.2.1",
        "lucide-react": "^1.18.0",
        "react": "^19.2.7",
        "react-dom": "^19.2.7",
        "react-error-boundary": "^6.1.2",
        "react-hook-form": "^7.79.0",
        "react-i18next": "^17.0.8",
        "react-redux": "^9.3.0",
        "redux": "^5.0.1",
        "typescript-color-gradient": "^4.2.0",
        "usehooks-ts": "^3.1.1"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.4",
        "@hookform/devtools": "^4.4.0",
        "@tanstack/router-devtools": "^1.167.0",
        "@tanstack/router-plugin": "^1.167.0",
        "@types/react": "^19.2.17",
        "@types/react-dom": "^19.2.3",
        "@vite-pwa/assets-generator": "^1.0.2",
        "@vitejs/plugin-react-swc": "^4.3.1",
        "eslint": "^9.39.4",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-react-refresh": "^0.5.3",
        "globals": "^17.6.0",
        "rollup-plugin-visualizer": "^7.0.1",
        "sass-embedded": "^1.100.0",
        "simple-git": "^3.36.0",
        "typescript": "~6.0.3",
        "typescript-eslint": "^8.61.0",
        "vite": "^8.0.16",
        "vite-plugin-compression": "^0.5.1",
        "vite-plugin-pwa": "^1.3.0",
        "vite-plugin-svgr": "^5.2.0",
        "vite-tsconfig-paths": "^6.1.1"
    }
